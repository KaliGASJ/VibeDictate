# ==============================================================================
# VibeDictate - user settings
# ==============================================================================
# install.sh copies this file to ~/.local/share/VibeDictate/env.sh on first run
# and never overwrites it afterwards, so your settings survive upgrades.
#
# This file is sourced by the `vibedictate-daemon` launcher as a normal shell
# script, so $HOME, ${VAR:-default} and comments all work as expected.
#
# Apply changes with:  systemctl --user restart vibedictate.service
#
# Library paths (CUDA) and the model cache location are handled by the launcher
# and must not be set here.

# ------------------------------------------------------------------------------
# 1. Model
# ------------------------------------------------------------------------------
# Downloaded once, then cached in ~/.local/share/VibeDictate/models/.
#   deepdml/faster-whisper-large-v3-turbo-ct2  best speed/accuracy, ~1.5 GB VRAM
#   large-v3                                   highest accuracy,   ~3.1 GB VRAM
#   medium | small | base | tiny               for CPU-only or low-VRAM GPUs
export VD_MODEL="${VD_MODEL:-deepdml/faster-whisper-large-v3-turbo-ct2}"

# ------------------------------------------------------------------------------
# 2. Hardware
# ------------------------------------------------------------------------------
# "auto" tries the GPU and falls back to the CPU. Use "cuda" or "cpu" to force.
export VD_DEVICE="${VD_DEVICE:-auto}"

# Precision: float16 (NVIDIA GPU), int8 (CPU or low VRAM), float32 (compatibility).
# Ignored and replaced by int8 when the daemon falls back to the CPU.
export VD_COMPUTE="${VD_COMPUTE:-float16}"

# ------------------------------------------------------------------------------
# 3. Language and vocabulary
# ------------------------------------------------------------------------------
# Two-letter code ("en", "es", "fr", "de"…) or empty for auto-detection.
# Setting it explicitly is faster and more accurate than auto-detection.
export VD_LANG="${VD_LANG:-en}"

# Optional priming text (~220 tokens max). Biases recognition towards the words
# you actually use: jargon, product names, acronyms, colleagues' names.
# Leave empty for plain general-purpose dictation.
export VD_PROMPT="${VD_PROMPT:-}"

# Decoding beam width. Higher is slightly more accurate and slower.
export VD_BEAM_SIZE="${VD_BEAM_SIZE:-5}"

# ------------------------------------------------------------------------------
# 4. Text injection
# ------------------------------------------------------------------------------
# auto      clipboard first, synthetic typing as fallback (recommended)
# clipboard clipboard + paste shortcut only
# type      always simulate keystrokes; slower, no clipboard involved
export VD_PASTE_METHOD="${VD_PASTE_METHOD:-auto}"

# Shortcut used to paste. ctrl+shift+v works in terminals, browsers and most
# editors. Switch to ctrl+v if you dictate mainly into office suites, where
# ctrl+shift+v opens a "paste special" dialog instead.
export VD_PASTE_KEY="${VD_PASTE_KEY:-ctrl+shift+v}"

# Milliseconds between synthetic keystrokes when VD_PASTE_METHOD=type.
export VD_TYPE_DELAY_MS="${VD_TYPE_DELAY_MS:-8}"

# Append a space after each dictation so phrases chain naturally.
export VD_TRAILING_SPACE="${VD_TRAILING_SPACE:-1}"

# ------------------------------------------------------------------------------
# 5. Privacy
# ------------------------------------------------------------------------------
# Restore the previous clipboard contents after pasting, so dictated text is not
# left behind for clipboard managers to store on disk. Set to 0 if a slow
# application ever pastes the wrong thing.
export VD_CLIPBOARD_RESTORE="${VD_CLIPBOARD_RESTORE:-1}"
export VD_CLIPBOARD_RESTORE_DELAY="${VD_CLIPBOARD_RESTORE_DELAY:-0.8}"

# Write transcribed text to the systemd journal. OFF by default: the journal is
# persisted to disk and readable by system administrators. Enable only while
# debugging, then disable it again.
export VD_LOG_TRANSCRIPT="${VD_LOG_TRANSCRIPT:-0}"

# ------------------------------------------------------------------------------
# 6. Audio and interface
# ------------------------------------------------------------------------------
# PipeWire/PulseAudio source name. Empty means the system default input.
# List available sources with: pactl list short sources
export VD_AUDIO_DEVICE="${VD_AUDIO_DEVICE:-}"

# Ignore captures shorter than this (seconds); filters accidental key presses.
export VD_MIN_DURATION="${VD_MIN_DURATION:-0.2}"

# Extra capture time after you stop, so the last syllable is never clipped.
export VD_TAIL_FLUSH="${VD_TAIL_FLUSH:-0.15}"

# Desktop notification bubbles, and the hotkey label shown inside them.
export VD_NOTIFICATIONS="${VD_NOTIFICATIONS:-1}"
export VD_HOTKEY_LABEL="${VD_HOTKEY_LABEL:-Ctrl+Space}"
